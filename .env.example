# Copy to .env.local and fill in with values from Supabase Project Settings -> API.
# Never commit .env.local (already covered by .gitignore).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, full DB access bypassing RLS. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=
